# Copy this file to .env (in this hw4/ folder) and fill in real values. Never commit .env.

# Required: API key for Portkey (the agent calls OpenAI's gpt5.6-luna through Portkey).
PORTKEY_API_KEY=your-portkey-api-key-here

# Required: secret used to sign login session cookies. Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: set to 1 when serving over HTTPS so the session cookie is HTTPS-only.
COOKIE_SECURE=0

# Optional: model reasoning effort, "default" or "none" (see output/usability.md).
AGENT_REASONING_EFFORT=default

# Optional: write the audit trail somewhere other than output/audit_trail.json.
# AUDIT_TRAIL_PATH=/tmp/campus_customs_audit.json
